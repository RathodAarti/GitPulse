
# Backend Environment Variables
# Rename this file to .env and fill in the values

NODE_ENV=development
PORT=5000

# MongoDB Connection String
MONGO_URI=mongodb://localhost:27017/gitpulse

# JWT Secret Key (generate a strong secret for production)
JWT_SECRET=your_jwt_secret_key_here

# Optional: GROQ API Key for AI features
GROQ_API_KEY=your_groq_api_key_here

# Optional: Default GitHub PAT for higher rate limits
GITHUB_DEFAULT_PAT=your_github_personal_access_token_here

# Frontend URL for CORS (set in production)
FRONTEND_URL=http://localhost:5173
